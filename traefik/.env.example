# IP address of the VM on the host-only network adapter.
# Used to bind dnsmasq's DNS ports to the correct interface.
# Must also match the address= line in dnsmasq.conf.
HOST_IP=192.168.56.3

# Traefik dashboard credentials (HTTP Basic Auth).
# Generate a new hash:  openssl passwd -apr1 yourpassword
# Then set: TRAEFIK_USERS=yourusername:hashoutput
# Example below uses admin / changeme — REPLACE before use.
TRAEFIK_USERS=admin:$$apr1$$ery4acfX$$3xIsTPI2zj0YrOnO8zSVc1
