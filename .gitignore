# Secret files - never commit
**/.env

# .md files
*.md

# Service data volumes
gitea/data/
gitea/db/
immich/db/
immich/photos/
stirling-pdf/configs/
stirling-pdf/logs/

# Generic dirs
logs/
config/
configs/
db/

# Traefik runtime files
traefik/logs/

# Wiki: ignore all runtime data but track pages
# Each level must be explicitly un-ignored before its contents can be re-ignored
data/
!wiki/data/
wiki/data/*
!wiki/data/data/
wiki/data/data/*
!wiki/data/data/pages/
